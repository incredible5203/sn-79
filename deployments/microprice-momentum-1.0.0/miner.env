# New miner — MicropriceMomentumMaker (Option C: directional touch-join, skip-if-unclear)
# Edit EXPECTED_UID, PM2_NAME, wallet, port, hotkey before deploy.
PM2_NAME=79-microprice-momentum
PRE_DELETE_PM2_NAMES="79-microprice-momentum"
EXPECTED_UID=18
WALLET_NAME=tensor-sub79
HOTKEY_NAME=hot6
AXON_PORT=5206

WALLET_PATH=~/.bittensor/wallets/
LOG_LEVEL=info
GENTRX=0
GENTRX_PARAMS=""

AGENT_NAME=MicropriceMomentumMaker
AGENT_PARAMS="cancel_all_on_startup=1 min_quantity=0.32 quantity_scale=1.0 max_fee_rate=0.0014 min_spread_ticks=3 max_spread_ratio=0.003 max_tape_imbalance=0.75 momentum_weight=0.6 microprice_weight=0.4 momentum_norm_scale=0.002 min_conviction=0.15 coverage_force_ticks=36 min_completion_rt_edge_ticks=3 completion_max_age_ns=12000000000 expiry_period=180000000000 rotation_groups=12 max_books_per_tick=11 max_total_instructions=28 max_instructions_per_book=4 inventory_skew_soft=0.08 inventory_skew_hard=0.20 stale_ticks_outside=2 stale_age_ns=7000000000 repay_loans_per_tick=1 max_blacklisted_books=46"

RELEASE_ID=microprice-momentum-1.0.0
SN79_REPO=/ttp/_tensor/sn-79
