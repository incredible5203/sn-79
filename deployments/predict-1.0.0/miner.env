# New miner — AscendPredictAgent (Ascend surge + CPU prediction overlay)
# Edit EXPECTED_UID, PM2_NAME, wallet, port, hotkey before deploy.
PM2_NAME=79-predict
PRE_DELETE_PM2_NAMES="79-predict"
EXPECTED_UID=127
WALLET_NAME=tensor-sub79
HOTKEY_NAME=hot5
AXON_PORT=5205

WALLET_PATH=~/.bittensor/wallets/
LOG_LEVEL=info
GENTRX=0
GENTRX_PARAMS=""

AGENT_NAME=AscendPredictAgent
AGENT_PARAMS="lazy_load=1 ascend_profile=surge cancel_all_on_startup=1 min_quantity=0.32 max_quantity=0.48 quantity_scale=1.0 max_fee_rate=0.001 expiry_period=180000000000 predict_threshold=0.002 predict_veto=1 predict_veto_threshold=0.002 agree_size_k=0.5 predict_max_books=13 predict_time_budget_ms=400"

RELEASE_ID=predict-1.1.0
SN79_REPO=/ttp/_tensor/sn-79
ENDPOINT=wss://entrypoint-finney.opentensor.ai:443
NETUID=79
BT_NO_PARSE_CLI_ARGS=false
PYTHONUNBUFFERED=1
