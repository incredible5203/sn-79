# TurboForgeV2Agent — recommended v2 default
PM2_NAME=
EXPECTED_UID=
WALLET_NAME=
HOTKEY_NAME=
AXON_PORT=

WALLET_PATH=~/.bittensor/wallets/
LOG_LEVEL=info
GENTRX=0
GENTRX_PARAMS=""

AGENT_NAME=TurboForgeV2Agent
AGENT_PARAMS="lazy_load=1 turbo_profile=forge min_quantity=0.28 max_quantity=0.44 quantity_scale=0.95 relative_threshold=0.00008 reversion_threshold=0.00012 cadence_interval_ns=21000000000 inventory_skew_soft=0.024 inventory_skew_hard=0.044 max_books_per_tick=11 book_rotation_groups=10 max_spread_ratio=0.0015 inactive_book_frac=0.28 max_two_sided_per_tick=4 max_instructions_per_book=4 max_total_instructions=28 max_fee_rate=0.002 expiry_period=180000000000 cancel_stale=1 max_cancel_per_book=2 max_requote_per_tick=4 min_fill_score=3.5 touch_join_on_requote=0 requote_ttl_ticks=6"
