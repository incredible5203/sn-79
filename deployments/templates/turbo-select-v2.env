# TurboSelectV2Agent — top fill-probability books only
PM2_NAME=
EXPECTED_UID=
WALLET_NAME=
HOTKEY_NAME=
AXON_PORT=

WALLET_PATH=~/.bittensor/wallets/
LOG_LEVEL=info
GENTRX=0
GENTRX_PARAMS=""

AGENT_NAME=TurboSelectV2Agent
AGENT_PARAMS="lazy_load=1 turbo_profile=select min_quantity=0.28 max_quantity=0.42 quantity_scale=0.94 relative_threshold=0.00009 reversion_threshold=0.00011 cadence_interval_ns=23000000000 inventory_skew_soft=0.024 inventory_skew_hard=0.044 max_books_per_tick=8 book_rotation_groups=14 max_spread_ratio=0.0014 inactive_book_frac=0.22 max_two_sided_per_tick=2 max_instructions_per_book=4 max_total_instructions=22 max_fee_rate=0.002 expiry_period=180000000000 cancel_stale=1 max_cancel_per_book=2 max_requote_per_tick=5 min_fill_score=6.0 touch_join_on_requote=1 requote_ttl_ticks=6"
