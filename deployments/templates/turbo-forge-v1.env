# TurboForgeAgent v1 — fill wallet fields before launch
PM2_NAME=
EXPECTED_UID=
WALLET_NAME=
HOTKEY_NAME=
AXON_PORT=

WALLET_PATH=~/.bittensor/wallets/
LOG_LEVEL=info
GENTRX=0
GENTRX_PARAMS=""

AGENT_NAME=TurboForgeAgent
AGENT_PARAMS="lazy_load=1 turbo_profile=forge min_quantity=0.28 max_quantity=0.44 quantity_scale=0.95 relative_threshold=0.00008 reversion_threshold=0.00012 cadence_interval_ns=21000000000 inventory_skew_soft=0.024 inventory_skew_hard=0.044 max_books_per_tick=11 book_rotation_groups=10 max_spread_ratio=0.0016 inactive_book_frac=0.30 max_two_sided_per_tick=4 max_instructions_per_book=4 max_total_instructions=28 max_fee_rate=0.002 expiry_period=180000000000"
