# New miner — PredictiveMakerAgent (Option A: inside-spread + OFI/microprice signals)
# Edit EXPECTED_UID, PM2_NAME, wallet, port, hotkey before deploy.
PM2_NAME=79-predictive-maker
PRE_DELETE_PM2_NAMES="79-predictive-maker"
EXPECTED_UID=None
WALLET_NAME=tensor-sub79
HOTKEY_NAME=main232
AXON_PORT=5206

WALLET_PATH=~/.bittensor/wallets/
LOG_LEVEL=info
GENTRX=0
GENTRX_PARAMS=""

AGENT_NAME=PredictiveMakerAgent
# v1.2.0: inside-spread quotes (not touch), fixed completion pricing, spread/RT gate, re-queue stale completions
AGENT_PARAMS="cancel_all_on_startup=1 min_quantity=0.32 quantity_scale=1.0 max_fee_rate=0.0014 inside_ticks=1 min_spread_ticks=6 max_spread_ratio=0.003 max_tape_imbalance=0.75 signal_threshold_strong=0.15 signal_threshold_weak=0.08 signal_adverse_skip=0.50 signal_ewm_alpha=0.30 min_completion_rt_edge_ticks=4 completion_max_age_ns=12000000000 expiry_period=180000000000 rotation_groups=12 max_books_per_tick=8 max_total_instructions=28 max_instructions_per_book=4 inventory_skew_soft=0.08 inventory_skew_hard=0.20 stale_ticks_outside=2 stale_age_ns=7000000000 repay_loans_per_tick=1 blacklist_after_losses=3 blacklist_duration=20 max_blacklisted_books=46"

RELEASE_ID=predictive-maker-1.2.0
SN79_REPO=/ttp/_tensor/sn-79
ENDPOINT=wss://entrypoint-finney.opentensor.ai:443
NETUID=79
BT_NO_PARSE_CLI_ARGS=false
PYTHONUNBUFFERED=1
