# TradePricePredictorAgent — driven by sn79-price-predictor (PM2: SN-79-Trade-Price-Predictor)
# Edit EXPECTED_UID, PM2_NAME, wallet, hotkey, port before deploy.
PM2_NAME=79-trade-price-predictor
PRE_DELETE_PM2_NAMES="79-trade-price-predictor"
EXPECTED_UID=140
WALLET_NAME=tensor-sub79
HOTKEY_NAME=hot8
AXON_PORT=5208

WALLET_PATH=~/.bittensor/wallets/
LOG_LEVEL=info
GENTRX=0
GENTRX_PARAMS=""

AGENT_NAME=TradePricePredictorAgent
# Requires predictor service: cd sn79-price-predictor && ./run.sh pm2
AGENT_PARAMS="predictor_url=http://127.0.0.1:8765 predictor_timeout_ms=800 predictor_cache_ttl_sec=0.8 require_commit=1 min_direction_edge=0.005 min_regime_accuracy=0.60 committed_size_mult=1.25 skip_uncommitted=0 veto_adverse_signal=1 cancel_all_on_startup=1 min_quantity=0.32 quantity_scale=1.0 max_fee_rate=0.0013 inside_ticks=1 min_spread_ticks=5 max_spread_ratio=0.003 min_completion_rt_edge_ticks=3 completion_max_age_ns=12000000000 completion_place_cooldown_ns=2000000000 completion_max_attempts=24 expiry_period=180000000000 rotation_groups=8 max_books_per_tick=10 max_completions_per_tick=6 max_total_instructions=28 max_instructions_per_book=4 inventory_skew_soft=0.08 inventory_skew_hard=0.15 stale_ticks_outside=2 stale_age_ns=7000000000 repay_loans_per_tick=1 max_blacklisted_books=46 flatten_max_qty_mult=2.0"

RELEASE_ID=trade-price-predictor-1.0.0
SN79_REPO=/ttp/_tensor/sn-79
ENDPOINT=wss://entrypoint-finney.opentensor.ai:443
NETUID=79
BT_NO_PARSE_CLI_ARGS=false
PYTHONUNBUFFERED=1
